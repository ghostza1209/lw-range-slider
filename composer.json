{
    "name": "ysz/lw-range-slider",
    "description": "A simple noUiSlider blade component designed specifically for your Livewire Components.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "YsZ\\LwRangeSlider\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YsZ\\LwRangeSlider\\Tests\\": "tests"
        }
    },
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Ysz"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "YsZ\\LwRangeSlider\\LwRangeSliderServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
